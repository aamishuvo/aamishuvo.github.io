const list = ((settings as any).social || []).filter((s: any) => s.url && ICONS[s.platform]);
---
<div class={`socials ${size}`}>
  {list.map((s: any) => (
    <a class="social-link" href={s.url} target="_blank" rel="noopener me" aria-label={s.label || s.platform} title={s.label || s.platform}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[s.platform]}></svg>
    </a>
  ))}
  {showEmail && (
    <a class="social-link" href={`mailto:${settings.contactEmail}`} aria-label="Email" title="Email">
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.email}></svg>
    </a>
  )}
</div>
