---
import '@fontsource/anton/400';
import '@fontsource/manrope/400';
import '@fontsource/manrope/500';
import '@fontsource/manrope/600';
import '@fontsource/manrope/700';
import '@fontsource/manrope/800';
import '@fontsource/space-mono/400';
import '@fontsource/caveat/500';
import '../styles/global.css';
import Social from '../components/Social.astro';
import settings from '../data/settings.json';

interface Props {
  lang: 'en' | 'bn';
  title: string;
  description: string;
  t: any; // language data blob (en.json / bn.json)
  path?: string;
}

const { lang, title, description, t } = Astro.props;
const base = lang === 'bn' ? '/bn' : '';
const homeHref = lang === 'bn' ? '/bn/' : '/';

const s: any = settings;
const links = [
  { href: homeHref, label: t.nav.home || 'Home' },
  { href: `${homeHref}#track`, label: t.nav.work },
  ...(s.navShowBoard ? [{ href: `${homeHref}#board`, label: t.nav.board }] : []),
  ...(s.navShowDiagnostic ? [{ href: `${homeHref}#diagnostic`, label: t.nav.diagnostic }] : []),
  { href: `${base}/about/`, label: t.nav.about || 'About' },
  { href: `${base}/contact/`, label: t.nav.contact },
  { href: `${base}/blog/`, label: t.nav.blog }
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/assets/img/portrait.webp" />
  <meta property="og:type" content="profile" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    // Apply saved Zero Bullshit mode before first paint to avoid a theme flash.
    if (localStorage.getItem('zb') === '1') document.documentElement.dataset.zb = '';
  </script>
</head>
<body>
  <a class="skip" href="#main">{lang === 'bn' ? 'মূল বিষয়ে যান' : 'Skip to content'}</a>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <header class="nav">
    <div class="shell">
      <a class="mark" href={homeHref} aria-label="Home">MI<span>·</span></a>
      <nav aria-label="Primary" class="nav-links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <button class="zb-toggle" id="zbToggle" aria-pressed="false"
        data-hint-on={t.zb.hintOn} data-hint-off={t.zb.hintOff}
        data-label-alt={t.zb.labelAlt || (lang === 'bn' ? 'কর্পোরেট মোড' : 'Corporate mode')}>
        <span class="zb-word">{t.zb.label}</span><i></i>
      </button>
      <a class="lang-switch" href={t.langSwitch.href}>{t.langSwitch.label}</a>
      <button class="burger" id="burger" aria-expanded="false"
        aria-label={lang === 'bn' ? 'মেনু' : 'Menu'} aria-controls="mobileMenu">
        <span></span><span></span>
      </button>
    </div>
  </header>
  <div class="zb-hint" id="zbHint" role="status"></div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    <nav aria-label={lang === 'bn' ? 'মোবাইল মেনু' : 'Mobile'}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <Social size="lg" showEmail={true} />
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="shell">
      <span>{t.footer.left}</span>
      <span>{t.footer.right}</span>
    </div>
  </footer>

  <script>
    import '../scripts/main.js';
    import '../scripts/zb.js';
  </script>
</body>
</html>
