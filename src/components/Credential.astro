---
// One education or certification row. Becomes a link when the entry has a url.
interface Props { item: any; }
const { item } = Astro.props;
const Tag = item.url ? 'a' : 'article';
const initial = String(item.org || item.credential || '?').trim().charAt(0);
---
<Tag
  class="edu-item reveal"
  href={item.url || undefined}
  target={item.url ? '_blank' : undefined}
  rel={item.url ? 'noopener' : undefined}
>
  <span class="org-logo" aria-hidden="true">
    {item.logo
      ? <img src={item.logo} alt="" loading="lazy" />
      : <span class="org-logo-fallback">{initial}</span>}
  </span>
  <div class="edu-main">
    <h4>{item.credential}</h4>
    <p class="edu-org">{item.org}{item.period ? ` · ${item.period}` : ''}</p>
  </div>
  {item.url && <span class="edu-ext" aria-hidden="true">↗</span>}
</Tag>
